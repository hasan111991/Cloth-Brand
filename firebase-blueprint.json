        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerCity": { "type": "string", "maxLength": 80 },
        "customerAddress": { "type": "string", "maxLength": 350 },
