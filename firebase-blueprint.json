        "bonusAmount": { "type": "number" },
        "deductions": { "type": "number" },
        "netPaid": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PAID"] },
        "paidDate": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeUid", "employeeName", "role", "monthKey", "baseSalary", "netPaid", "status", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_\\-]+$", "maxLength": 40 },
        "discountType": { "type": "string", "enum": ["PERCENT", "FIXED"] },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountType", "discountValue", "active", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review with moderation.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 800 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerName", "rating", "comment", "status", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Salesman and social campaign lead tracking.",
      "type": "object",
      "properties": {
        "salesmanId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "source": { "type": "string", "enum": ["WHATSAPP", "FACEBOOK", "INSTAGRAM", "DIRECT"] },
        "interestedProduct": { "type": "string", "maxLength": 140 },
        "status": { "type": "string", "enum": ["NEW", "CONTACTED", "FOLLOW_UP", "CONVERTED", "LOST"] },
        "notes": { "type": "string", "maxLength": 500 },
        "nextFollowUp": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["salesmanId", "customerName", "phone", "source", "status", "createdAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Marketing campaign attribution configuration.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "channel": { "type": "string", "enum": ["WHATSAPP", "FACEBOOK", "INSTAGRAM", "WEBSITE"] },
        "utmCode": { "type": "string", "maxLength": 60 },
        "budget": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "channel", "utmCode", "active", "createdAt"]
    },
    "AbandonedCart": {
      "title": "AbandonedCart",
      "description": "Captured checkout abandonment for recovery.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "itemsCount": { "type": "number" },
        "totalValue": { "type": "number" },
        "recovered": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerPhone", "itemsCount", "totalValue", "recovered", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable sensitive operations audit log.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 150 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "entityType", "entityId", "createdAt"]
    }
  },
