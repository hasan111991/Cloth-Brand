        "paymentMethod": { "type": "string", "enum": ["COD", "BANK_TRANSFER"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PROOF_SUBMITTED", "VERIFIED", "COD_EXPECTED", "COD_COLLECTED", "RECONCILED", "REFUNDED"] },
        "courierCompany": { "type": "string", "maxLength": 80 },
        "trackingNumber": { "type": "string", "maxLength": 80 },
        "couponCode": { "type": "string", "maxLength": 40 },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "shippingCharges": { "type": "number" },
        "totalAmount": { "type": "number" },
        "suitsCount": { "type": "number" },
        "itemsSummary": { "type": "array" },
        "statusHistory": { "type": "array" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "customerCity", "customerAddress", "source", "status", "paymentMethod", "paymentStatus", "subtotal", "discountAmount", "shippingCharges", "totalAmount", "suitsCount", "createdAt", "updatedAt"]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Non-PII public order tracking status readable by exact orderNumber.",
