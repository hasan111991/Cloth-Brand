        "trackingNumber": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "totalAmount": { "type": "number" },
        "statusHistory": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "status", "paymentStatus", "updatedAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Line item belonging to an order.",
