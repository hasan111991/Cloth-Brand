{
  "entities": {
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Public storefront and business configuration edited by Owner/Admin.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "maxLength": 7 },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "maxLength": 7 },
        "audienceType": { "type": "string", "enum": ["Ladies", "Gents", "Both"] },
        "contactEmail": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "deliveryCoverage": { "type": "string", "maxLength": 300 },
        "courierProviders": { "type": "array" },
        "returnPolicy": { "type": "string", "maxLength": 2000 },
        "shippingPolicy": { "type": "string", "maxLength": 2000 },
        "privacyPolicy": { "type": "string", "maxLength": 2000 },
        "termsPolicy": { "type": "string", "maxLength": 2000 },
        "aboutText": { "type": "string", "maxLength": 2000 },
        "shippingCharges": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "paymentMethods": { "type": "array" },
        "bankDetails": { "type": "string", "maxLength": 500 },
        "currency": { "type": "string", "enum": ["PKR"] },
        "setupCompleted": { "type": "boolean" },
        "salesmanDefaults": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandName", "audienceType", "currency", "setupCompleted", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with strict RBAC role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "SALES_MANAGER", "SALESMAN", "INVENTORY_MANAGER", "PACKING_STAFF", "CUSTOMER"] },
        "active": { "type": "boolean" },
        "baseSalary": { "type": "number" },
        "salesmanId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "active", "createdAt", "updatedAt"]
    },
    "StaffInvite": {
      "title": "StaffInvite",
      "description": "Pre-authorized staff email role assignment created by Owner/Admin.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["ADMIN", "SALES_MANAGER", "SALESMAN", "INVENTORY_MANAGER", "PACKING_STAFF"] },
        "baseSalary": { "type": "number" },
        "monthlyTargetSuits": { "type": "number" },
        "claimed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "claimed", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "pattern": "^[a-z0-9\\-]+$", "maxLength": 100 },
        "audience": { "type": "string", "enum": ["Ladies", "Gents", "Both"] },
        "description": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "audience", "active", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Public storefront product listing (strictly excludes purchase cost).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "slug": { "type": "string", "pattern": "^[a-z0-9\\-]+$", "maxLength": 160 },
        "sku": { "type": "string", "maxLength": 64 },
        "categoryId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "audience": { "type": "string", "enum": ["Ladies", "Gents", "Both"] },
        "description": { "type": "string", "maxLength": 2000 },
        "fabric": { "type": "string", "maxLength": 120 },
        "sellingPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "totalAvailable": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "sku", "categoryId", "audience", "sellingPrice", "active", "createdAt", "updatedAt"]
    },
    "ProductVariant": {
      "title": "ProductVariant",
      "description": "Variant SKU with size, color, and public stock counters (no purchase cost).",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "size": { "type": "string", "maxLength": 32 },
        "color": { "type": "string", "maxLength": 40 },
        "sellingPrice": { "type": "number" },
        "stockAvailable": { "type": "number" },
        "stockReserved": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "sku", "size", "color", "stockAvailable", "stockReserved", "active", "updatedAt"]
    },
    "InventoryBatch": {
      "title": "InventoryBatch",
      "description": "Staff-only FIFO inventory batch containing purchase cost.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "variantId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "batchCode": { "type": "string", "maxLength": 64 },
        "purchaseCost": { "type": "number" },
        "initialQty": { "type": "number" },
        "remainingQty": { "type": "number" },
        "reservedQty": { "type": "number" },
        "supplierId": { "type": "string", "maxLength": 128 },
        "purchaseOrderId": { "type": "string", "maxLength": 128 },
        "warehouseLocation": { "type": "string", "maxLength": 100 },
        "receivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "variantId", "sku", "purchaseCost", "initialQty", "remainingQty", "reservedQty", "createdAt"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable stock movement audit log.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "variantId": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["RECEIPT", "RESERVE", "RELEASE", "DEDUCT", "RETURN", "ADJUSTMENT"] },
        "quantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 300 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "variantId", "type", "quantity", "performedBy", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor/supplier record with payable balance.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "city": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 300 },
        "catalogSummary": { "type": "string", "maxLength": 500 },
        "totalPurchased": { "type": "number" },
        "totalPaid": { "type": "number" },
        "outstandingPayable": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "totalPurchased", "totalPaid", "outstandingPayable", "active", "createdAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Procurement request and purchase order lifecycle.",
