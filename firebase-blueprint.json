        "totalCost": { "type": "number" },
        "paidAmount": { "type": "number" },
        "linkedOrderId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "requestedBy": { "type": "string", "maxLength": 128 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["poNumber", "supplierId", "status", "totalCost", "paidAmount", "requestedBy", "createdAt", "updatedAt"]
    },
    "PurchaseItem": {
      "title": "PurchaseItem",
      "description": "Purchase order line item.",
